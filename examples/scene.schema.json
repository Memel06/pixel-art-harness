{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pixel-art-harness:scene:v1",
  "title": "Pixel Art Harness scene v1",
  "type": "object",
  "required": ["version", "canvas", "palette", "frames"],
  "properties": {
    "version": {"const": 1},
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 2048},
        "height": {"type": "integer", "minimum": 1, "maximum": 2048}
      }
    },
    "palette": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"}
    },
    "frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frame"}},
    "tags": {"type": "array", "items": {"$ref": "#/$defs/tag"}}
  },
  "$defs": {
    "color": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$"}
      ]
    },
    "command": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": {"enum": ["pixel", "line", "rect", "ellipse", "polygon", "image"]},
        "x": {"type": "integer"}, "y": {"type": "integer"},
        "x1": {"type": "integer"}, "y1": {"type": "integer"},
        "x2": {"type": "integer"}, "y2": {"type": "integer"},
        "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
        "color": {"$ref": "#/$defs/color"}, "fill": {"type": "boolean"},
        "points": {"type": "array", "minItems": 3, "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false}},
        "path": {"type": "string", "minLength": 1}, "scale": {"type": "integer", "minimum": 1},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255}
      },
      "allOf": [
        {"if": {"properties": {"op": {"const": "pixel"}}}, "then": {"required": ["x", "y", "color"]}},
        {"if": {"properties": {"op": {"const": "line"}}}, "then": {"required": ["x1", "y1", "x2", "y2", "color"]}},
        {"if": {"properties": {"op": {"enum": ["rect", "ellipse"]}}}, "then": {"required": ["x", "y", "width", "height", "color"]}},
        {"if": {"properties": {"op": {"const": "polygon"}}}, "then": {"required": ["points", "color"]}},
        {"if": {"properties": {"op": {"const": "image"}}}, "then": {"required": ["path", "x", "y"]}}
      ]
    },
    "layer": {
      "type": "object",
      "required": ["name", "commands"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "visible": {"type": "boolean"},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}}
      }
    },
    "frame": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "duration": {"type": "integer", "minimum": 1},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}
      }
    },
    "tag": {
      "type": "object",
      "required": ["name", "from", "to"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "from": {"type": "integer", "minimum": 0}, "to": {"type": "integer", "minimum": 0},
        "direction": {"enum": ["forward", "reverse", "pingpong", "pingpong_reverse"]}
      }
    }
  }
}
